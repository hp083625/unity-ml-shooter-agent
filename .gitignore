# Standard Unity .gitignore — based on github.com/github/gitignore Unity.gitignore
# plus a few project-specific exclusions.

# Unity-generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Asset import data and cached previews
/[Aa]ssets/AssetStoreTools*

# Generated by Unity for autogenerated scenes
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Visual Studio cache
.vs/
.vsconfig
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.unityproj
*.tmp
*.pidb

# Rider / VSCode
.idea/
.vscode/

# Python tooling (training venv)
tools/training/.venv/
__pycache__/
*.pyc

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS junk
.DS_Store
Thumbs.db

# Claude Code local state
.claude/
